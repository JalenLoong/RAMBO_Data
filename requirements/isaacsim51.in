# RAMBO's direct runtime intent for Isaac Sim 5.1 / Isaac Lab 2.3.2 on Linux x86_64.
# The installer applies setuptools/flatdict first; they are repeated here so re-installs
# cannot accidentally upgrade past the compatibility workaround.
--extra-index-url https://pypi.nvidia.com
--extra-index-url https://download.pytorch.org/whl/cu128

setuptools<81
flatdict==4.0.1
wheel==0.45.1
numpy<2
torch==2.7.0+cu128
torchvision==0.22.0+cu128
isaaclab[isaacsim,all]==2.3.2
# Isaac Lab's wheel bundles (but does not auto-install) ``isaaclab_assets``.
# scripts/setup_isaacsim51.sh installs that exact official bundled extension;
# do not replace it with this repository's vendored source/isaaclab_assets.
# Isaac Sim 5.1 pins packaging==23.0 and osqp==0.6.7.post3.  qpth itself
# works with this older CVXPY stack; pin it so pip does not pull a newer
# CVXPY/OSQP pair that breaks the official simulator distribution.
packaging==23.0
osqp==0.6.7.post3
cvxpy==1.5.4
ecos==2.0.14
qpth==0.0.18
